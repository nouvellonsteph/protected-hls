{
  "name": "protected-hls-delivery-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Reference implementation for protected HLS delivery and live HLS ingest on Cloudflare Workers.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "deploy": "npm run verify && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "test": "vitest run --config vitest.config.ts",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "verify": "npm run types:check && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/kumo": "2.14.0",
    "@phosphor-icons/react": "2.1.10",
    "hls.js": "1.7.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.145.0"
  }
}
