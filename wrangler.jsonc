{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "protected-hls-delivery-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  // The control routes are intentionally unreachable after deployment until
  // you add a route protected by Cloudflare Access or equivalent policy.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/api/*",
      "/media/*",
      "/ingest/*",
      "/publish/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "protected-hls-demo-media"
    }
  ],
  "containers": [
    {
      "class_name": "LivePublisherContainer",
      "image": "./container/Dockerfile",
      "image_build_context": "./container",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "secrets": {
    "required": [
      "ACCESS_PRIMARY_SECRET",
      "ACCESS_TRANSITION_SECRET",
      "SESSION_SECRET",
      "INGEST_SECRET"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STREAM_COORDINATOR",
        "class_name": "StreamCoordinator"
      },
      {
        "name": "LIVE_PUBLISHER",
        "class_name": "LivePublisherContainer"
      }
    ]
  },
  "exports": {
    "StreamCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "LivePublisherContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ACCESS_TOKEN_TTL_SECONDS": "300",
    "SESSION_TOKEN_TTL_SECONDS": "3600",
    "MAX_SESSION_TTL_SECONDS": "86400"
  },
  // Token values appear in demo URLs. Keep automatic request logging disabled
  // unless URL fields are redacted before storage or export.
  "observability": { "enabled": false }
}
